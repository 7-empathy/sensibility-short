{
  "name": "sensibility-short",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts SensibilityShort out/sensibility.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --muted",
    "preview": "remotion render src/index.ts SensibilityShort out/preview.mp4 --codec=h264 --crf=23 --scale=0.5 --muted"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
